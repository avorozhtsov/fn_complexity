#!/usr/bin/env python3
"""Generate the six homogeneous-tensor diagrams over F_3."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT / "src"))

from fn_complexity.homogeneous_tensor_maps import (  # noqa: E402
    TENSOR_CASES,
    compute_tensor_poset,
    minimum_orbit_counts_for_case6,
    rank_counts_for_case6,
    render_case6_scale_svg,
    render_tensor_poset_svg,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Draw q=3 degeneration posets for homogeneous quadratic and cubic "
            "tensors with possibly singular linear input/output processors."
        )
    )
    parser.add_argument(
        "cases",
        nargs="*",
        type=int,
        choices=range(1, 7),
        default=list(range(1, 7)),
        help="case numbers 1 through 6 (default: all)",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=PROJECT_ROOT / "paper_finite_fields_maps" / "images",
        help="directory for generated SVGs",
    )
    parser.add_argument(
        "--titles",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="include the visible graph heading (default: titles)",
    )
    return parser.parse_args()


def output_path(case_number: int, directory: Path) -> Path:
    case = TENSOR_CASES[case_number]
    return directory / f"homogeneous-tensor-poset-q3-case{case_number}-{case.short_name}.svg"


def main() -> int:
    args = parse_args()
    args.output_dir.mkdir(parents=True, exist_ok=True)
    print("case\ttensors\tclasses\tcovers\toutput")
    case4_orbits = None
    for case_number in dict.fromkeys(args.cases):
        case = TENSOR_CASES[case_number]
        output = output_path(case_number, args.output_dir)
        if case_number == 6:
            if case4_orbits is None:
                case4_orbits = len(compute_tensor_poset(4).orbits)
            exact_rank1_orbits = case4_orbits - 1
            render_case6_scale_svg(
                output,
                exact_rank1_orbits,
                show_titles=args.titles,
            )
            minima = minimum_orbit_counts_for_case6()
            minimum_classes = minima[3] + minima[2] + exact_rank1_orbits + 1
            print(
                f"6\t{sum(rank_counts_for_case6().values())}\t"
                f">={minimum_classes}\tN/A\t{output}"
            )
            continue
        poset = compute_tensor_poset(case_number)
        if case_number == 4:
            case4_orbits = len(poset.orbits)
        render_tensor_poset_svg(poset, output, show_titles=args.titles)
        print(
            f"{case_number}\t{case.tensor_count}\t{len(poset.orbits)}\t"
            f"{len(poset.covers)}\t{output}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
