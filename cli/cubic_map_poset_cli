#!/usr/bin/env python3
"""Generate cubic-map degeneration diagrams over F_3 or F_8."""

from __future__ import annotations

import argparse
from pathlib import Path
import sys


PROJECT_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(PROJECT_ROOT / "src"))

from fn_complexity.cubic_field_maps import (  # noqa: E402
    cubic_q3_classes,
    cubic_q3_map_count,
    cubic_q8_generated_class_count,
    cubic_q8_map_count,
    render_cubic_q3_poset_svg,
    render_cubic_q8_quadratic_poset_svg,
)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description=(
            "Draw degree-at-most-three maps F_q^2 -> F_q with affine or "
            "quadratic input processors and affine output processors. "
            "The q=8 implementation currently covers quadratic inputs."
        )
    )
    parser.add_argument(
        "--q",
        type=int,
        choices=(3, 8),
        default=3,
        help="field order (default: 3)",
    )
    parser.add_argument(
        "--case",
        choices=("linear", "quadratic", "both"),
        default="both",
        help="input-processor case to render (default: both)",
    )
    parser.add_argument(
        "--output-dir",
        type=Path,
        default=PROJECT_ROOT / "paper_finite_fields_maps" / "images",
        help="directory for generated SVGs",
    )
    parser.add_argument(
        "--titles",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="include the visible graph heading (default: titles)",
    )
    return parser.parse_args()


def main() -> int:
    args = parse_args()
    if args.q == 8:
        if args.case != "quadratic":
            raise SystemExit("q=8 currently requires --case quadratic")
        output = args.output_dir / "cubic-map-poset-q8-quadratic-input.svg"
        render_cubic_q8_quadratic_poset_svg(output, show_titles=args.titles)
        print("case\tmaps\tclasses\toutput")
        print(
            f"quadratic\t{cubic_q8_map_count()}\t"
            f"{cubic_q8_generated_class_count()}\t{output}"
        )
        return 0

    cases = ("linear", "quadratic") if args.case == "both" else (args.case,)
    args.output_dir.mkdir(parents=True, exist_ok=True)
    print("case\tmaps\tclasses\toutput")
    for processor_case in cases:
        output = (
            args.output_dir
            / f"cubic-map-poset-q3-{processor_case}-input.svg"
        )
        render_cubic_q3_poset_svg(
            processor_case,
            output,
            show_titles=args.titles,
        )
        print(
            f"{processor_case}\t{cubic_q3_map_count()}\t"
            f"{len(cubic_q3_classes(processor_case))}\t{output}"
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
